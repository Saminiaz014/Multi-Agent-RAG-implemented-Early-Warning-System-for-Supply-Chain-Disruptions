# Compose-time settings for the local Airflow stack. NO API KEYS HERE —
# real keys stay in the project root's gitignored .env, which reaches the
# containers via the project bind mount and python-dotenv.
AIRFLOW_UID=50000
# Timezone the "0 8 * * *" schedule (and the freshness marker) run in.
AIRFLOW_TZ=Europe/Berlin
# Airflow web UI login (http://localhost:8080). Local-only defaults.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
