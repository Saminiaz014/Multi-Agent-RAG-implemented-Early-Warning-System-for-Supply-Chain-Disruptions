# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Secrets (do not commit API keys)
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Data (raw inputs — not versioned)
data/raw/
data/processed/
data/benchmark/

# EVAL01 benchmark results (generated, reproducible via scripts/run_*.py —
# not versioned; results/baselines/tier0/*.json is a pre-existing
# exception already committed from an earlier run and stays tracked)
results/baselines/tier1/
results/baselines/tier2/
results/baselines/ablations/
results/*.csv
results/benchmark_summary*.md
results/_archive/

# ChromaDB persistence (binary store stays ignored; the JSON snapshot
# live_extracted_backup.json IS committed — it is the portable seed that
# rebuilds the live collection on fresh deploys)
data/knowledge_base/.chromadb/
data/knowledge_base/.chromadb_test_*/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
data/knowledge_base/chroma/
