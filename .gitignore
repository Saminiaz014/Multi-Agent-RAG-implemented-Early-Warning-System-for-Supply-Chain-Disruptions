# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Secrets (do not commit API keys)
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Data (raw inputs — not versioned)
data/raw/
data/processed/

# ChromaDB persistence
data/knowledge_base/.chromadb/
data/knowledge_base/.chromadb_test_*/
# XAI-02 eval copy of the knowledge base (production DB + 2023-25 backfill)
data/knowledge_base/.chromadb_xai/
# Raw API responses cached by the XAI-02 backfill (rebuilt without spending quota)
eval/explainability/backfill_raw/
data/knowledge_base/live_extracted_backup.json

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Thesis writing (FAPS LaTeX template + local drafts) — never commit/push.
# Exception: the Chapter 4 figure captions are tracked so each figure's exact
# numbers are versioned; the images are rebuilt by
# eval/explainability/make_figures.py. (Ignoring the directory itself would
# stop git descending into it, so the pattern ignores its contents instead.)
thesis/*
!thesis/figures/
thesis/figures/*
!thesis/figures/ch4/
thesis/figures/ch4/*
!thesis/figures/ch4/*.caption.txt

# Generated evaluation matrices (rebuilt by scripts from the knowledge base)
data/eval/

# Pre-migration knowledge-base snapshots
data/knowledge_base/live_extracted_backup.pre_*.json

docs/
