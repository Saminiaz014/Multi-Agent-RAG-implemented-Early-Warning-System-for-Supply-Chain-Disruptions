# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys for each service below
# 3. Keep .env in .gitignore (never commit real keys)
# 4. Every key is optional — extractors and DisasterConnector.fetch_api()
#    log a warning and degrade gracefully (empty results / synthetic
#    fallback) when a key is missing, so a partial .env never breaks
#    the pipeline.
# 5. See README.md for sign-up links and which phase introduced each key.

# Economic data (FRED — U.S. Federal Reserve Data)
FRED_API_KEY=

# News aggregation (NewsAPI)
NEWSAPI_KEY=

# Vessel tracking (AIS Stream) — only needed if aisstream.enabled: true
AISSTREAM_API_KEY=

# Geopolitical events (ACLED)
ACLED_USERNAME=
ACLED_PASSWORD=

# Environmental & disaster data (Ambee)
AMBEE_API_KEY=

# Web search & business data (SerpAPI)
SERPAPI_API_KEY=

# Dashboard map style/terrain (Phase 9b, optional — keyless OpenFreeMap +
# AWS DEM used otherwise)
MAPTILER_API_KEY=

# LLM-generated risk explanations on the Decision view (Phase 9b, optional
# — a deterministic compositional fallback is used otherwise)
ANTHROPIC_API_KEY=
